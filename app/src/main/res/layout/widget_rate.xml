<?xml version="1.0" encoding="utf-8"?>
<!--
  Widgets are RemoteViews, not Compose: only a fixed set of framework views is
  allowed here, and theme attributes don't resolve, so every colour is a literal
  that reads acceptably on both light and dark launcher wallpapers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_pair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/widget_muted"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:maxLines="1" />

    <!-- The pinned currencies, hidden entirely when there are none. -->
    <TextView
        android:id="@+id/widget_extras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="@color/widget_text"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="@color/widget_muted"
        android:maxLines="1" />

</LinearLayout>
