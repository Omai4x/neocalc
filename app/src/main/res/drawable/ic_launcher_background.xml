<?xml version="1.0" encoding="utf-8"?>
<!--
  Flat fills only: VectorDrawable gradients need API 24 and this project's
  minSdk is 23. The diagonal gives depth without one.

  Warm stone rather than the cool near-black it started as, so the icon sits in
  the same family as the app it opens. #1C1917 is the app's own ground colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#1C1917"
        android:pathData="M0,0h108v108h-108z" />

    <path
        android:fillColor="#292524"
        android:pathData="M108,0L108,108L0,108Z" />
</vector>
